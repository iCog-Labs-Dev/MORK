(mln-site (Cancer P049) (# 2))

(mln-rng 987654321 0)

(mln-flip false true)
(mln-flip true false)
(mln-lit-sat positive false 0)
(mln-lit-sat positive true 1)
(mln-lit-sat negative false 1)
(mln-lit-sat negative true 0)

; Build one local score delta and proposed cache update per incident clause.
(mln-process $step $x $old $new
  (exec (mln p10 $step)
    (, (mln-proposal $step $x $old $new)
       (mln-in-clause $x $c $polarity)
       (mln-clause $c $weight)
       (mln-sat-count $c $old_count)
       (mln-lit-sat $polarity $old $old_lit_sat)
       (mln-lit-sat $polarity $new $new_lit_sat))
    (O
      (pure
        (mln-clause-update $step $x $c $old_count $new_count)
        $new_count
        (i64_to_string
          (sum_i64
            (i64_from_string $old_count)
            (neg_i64 (i64_from_string $old_lit_sat))
            (i64_from_string $new_lit_sat))))
      (pure
        (mln-delta-part $step $x $c $part)
        $part
        (f64_to_string
          (product_f64
            (f64_from_string $weight)
            (i8_as_f64
              (sub_i8
                (gt_i64
                  (sum_i64
                    (i64_from_string $old_count)
                    (neg_i64 (i64_from_string $old_lit_sat))
                    (i64_from_string $new_lit_sat))
                  (i64_from_string 0))
                (gt_i64
                  (i64_from_string $old_count)
                  (i64_from_string 0))))))))))

; Aggregate all incident-clause score changes.
(mln-process $step $x $old $new
  (exec (mln p20 $step)
    (, (mln-delta-part $step $x $c $part))
    (O
      (fsum (mln-delta $step $x $delta) $delta $part))))

; Metropolis acceptance in log space.
(mln-process $step $x $old $new
  (exec (mln p30 $step)
    (, (mln-delta $step $x $delta)
       (mln-random $step $x $u))
    (O
      (pure (mln-decision $step $x $decision) $decision
        (ifnz
          (gte_f64
            (f64_from_string $delta)
            (f64_from_string 0.0))
          then accept
          else
            (ifnz
              (lte_f64
                (ln_f64 (f64_from_string $u))
                (f64_from_string $delta))
              then accept
              else reject))))))

; Rewrite an accepted assignment.
(mln-process $step $x $old $new
  (exec (mln p40 $step)
    (, (mln-decision $step $x accept)
       (mln-proposal $step $x $old $new)
       (mln-delta $step $x $delta)
       (mln-val $x $old))
    (O
      (- (mln-val $x $old))
      (+ (mln-val $x $new))
      (+ (mln-accepted $step $x $old $new $delta)))))

; Rewrite only the accepted variable's incident-clause caches.
(mln-process $step $x $old $new
  (exec (mln p41 $step)
    (, (mln-decision $step $x accept)
       (mln-clause-update $step $x $c $old_count $new_count)
       (mln-sat-count $c $old_count))
    (O
      (- (mln-sat-count $c $old_count))
      (+ (mln-sat-count $c $new_count))
      (- (mln-clause-update $step $x $c $old_count $new_count)))))

; A rejection preserves assignment and cache state.
(mln-process $step $x $old $new
  (exec (mln p42 $step)
    (, (mln-decision $step $x reject)
       (mln-proposal $step $x $old $new)
       (mln-delta $step $x $delta))
    (O
      (+ (mln-rejected $step $x $old $new $delta)))))

(mln-process $step $x $old $new
  (exec (mln p45 $step)
    (, (mln-decision $step $x $decision)
       (mln-clause-update $step $x $c $old_count $new_count))
    (O
      (- (mln-clause-update $step $x $c $old_count $new_count)))))

(mln-process $step $x $old $new
  (exec (mln p46 $step)
    (, (mln-delta-part $step $x $c $part))
    (O
      (- (mln-delta-part $step $x $c $part)))))

; Retain one sample event per completed transition.
(mln-process $step $x $old $new
  (exec (mln p48 $step)
    (, (mln-decision $step $x $decision)
       (mln-proposal $step $x $old $new)
       (mln-delta $step $x $delta)
       (mln-random $step $x $u)
       (mln-val $x $state))
    (O
      (+ (mln-sample $step $x $state $decision $delta $u)))))

; Remove transaction-local state.
(mln-process $step $x $old $new
  (exec (mln p49 $step)
    (, (mln-decision $step $x $decision)
       (mln-proposal $step $x $old $new)
       (mln-delta $step $x $delta)
       (mln-random $step $x $u))
    (O
      (- (mln-decision $step $x $decision))
      (- (mln-proposal $step $x $old $new))
      (- (mln-delta $step $x $delta))
      (- (mln-random $step $x $u)))))

; One weighted site event followed by bounded metta-calculus execution is one
; serial MCMC transition.
(sweep social-mln-big
  (e random_walk)
  (src (, (mln-site $x)))
  (weight first)
  (sink
    (O
      (+ (was-sampled social-mln-big (mln-site $x)))

      (+ (exec (mln p00 mutable $x)
           (, (was-sampled social-mln-big (mln-site $x))
              (mln-mutable $x)
              (mln-val $x $old)
              (mln-flip $old $new)
              (mln-rng $seed $step))
           (O
             (- (was-sampled social-mln-big (mln-site $x)))
             (- (mln-rng $seed $step))
             (pure (mln-rng $seed $next_step) $next_step
               (i64_to_string
                 (sum_i64
                   (i64_from_string $step)
                   (i64_one))))
             (pure (mln-random $step $x $u) $u
               (f64_to_string
                 (uniform_f64_from_seed
                   (i64_from_string $seed)
                   (i64_from_string $step))))
             (+ (mln-proposal $step $x $old $new))
             (+ (mln-delta-part $step $x baseline 0.0))
             (+ (mln-activate $step $x $old $new))
             (+ (exec (mln p01 $step)
                  (, (mln-activate $step $x $old $new)
                     (mln-process $step $x $old $new $process))
                  (O
                    (+ $process)
                    (- (mln-activate $step $x $old $new))))))))

      ; Evidence is never scheduled in a valid model, but malformed input is guarded.
      (+ (exec (mln p00 evidence $x)
           (, (was-sampled social-mln-big (mln-site $x))
              (mln-evidence $x $value))
           (O
             (- (was-sampled social-mln-big (mln-site $x)))
             (+ (mln-skipped-evidence $x))))))))
